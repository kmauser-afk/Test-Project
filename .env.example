# ── Database ───────────────────────────────────────────────────────────────
# Pooled connection for runtime queries.
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"
# Direct (unpooled) connection — used ONLY for migrations (advisory lock).
DIRECT_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# openssl rand -base64 33
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"
# Optional: enable trustHost behind a proxy / App Service
AUTH_TRUST_HOST="true"

# ── Microsoft Entra ID (Azure AD) OIDC — enterprise SSO ────────────────────
# When these are set, the Entra provider is enabled. Leave blank for local
# Credentials-only development (see prisma/seed.ts for the seeded admin login).
AUTH_ENTRA_ID_ID=""
AUTH_ENTRA_ID_SECRET=""
AUTH_ENTRA_ID_TENANT_ID=""

# ── Microsoft Graph (email intake / send) — later phase ────────────────────
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_TENANT_ID=""

# ── Azure Blob Storage (attachments) — later phase ─────────────────────────
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_CONTAINER="attachments"

# ── Shared secret guarding /api/jobs/* and /api/admin/bootstrap ────────────
JOBS_SHARED_SECRET="change-me-too"

NODE_ENV="development"
